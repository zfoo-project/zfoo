<?xml version="1.0" encoding="UTF-8" standalone="no" ?>

<!-- An XSD file itself is an XML file; the first line is the XML declaration -->
<!-- The first line is required:
        the version attribute specifies the XML version,
        the encoding attribute specifies the character encoding,
        and the standalone attribute specifies whether this XML document is standalone (yes: cannot reference external DTD files; no: not standalone and can use external DTD files).
        XML attribute values must be enclosed in quotes. -->

<!--************************************** Divider **************************************************-->

<!-- The first xmlns attribute specifies that elements and data types used in this schema come from the namespace "http://www.w3.org/2001/XMLSchema".
        It also stipulates that elements and data types from "http://www.w3.org/2001/XMLSchema" should use the prefix xsd (which can be any custom name): -->

<!-- The second xmlns attribute references the Spring beans namespace -->

<!-- xmlns="http://www.zfoo.com/schema/user" specifies that the default namespace is "http://www.zfoo.com/schema/user" -->
<!-- targetNamespace indicates that the elements defined by this schema (note, to, from, heading, body) come from the namespace:
        http://www.zfoo.com/schema/user -->

<!-- elementFormDefault specifies that any elements used by an XML instance document and declared in this schema must be namespace-qualified. -->
<!-- attributeFormDefault attribute:
        Specifies whether local attributes defined in this schema must be namespace-qualified when used in an XML document:
        qualified: must be qualified with a namespace prefix; unqualified: (default) does not need to be qualified with a namespace prefix -->

<!--************************************** Divider **************************************************-->

<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema"

            xmlns="http://www.zfoo.com/schema/storage"
            targetNamespace="http://www.zfoo.com/schema/storage"

            elementFormDefault="qualified"
            attributeFormDefault="unqualified">


    <!-- scan package type -->
    <!-- package declaration type -->
    <xsd:complexType name="scan">
        <xsd:attribute name="package" type="xsd:string" use="required"/>
        <xsd:attribute name="writeable" type="xsd:boolean" default="false"/>
        <xsd:attribute name="recycle" type="xsd:boolean" default="true"/>
    </xsd:complexType>


    <!-- Format declaration type -->
    <xsd:complexType name="resource">
        <!-- Local resource path -->
        <xsd:attribute name="location" type="xsd:string" use="required"/>
    </xsd:complexType>

    <xsd:complexType name="configType">
        <xsd:sequence>
            <xsd:element name="scan" type="scan"/>
            <xsd:element name="resource" type="resource"/>
        </xsd:sequence>
        <xsd:attribute name="id" type="xsd:string" use="required"/>
    </xsd:complexType>

    <!-- Defines the element tag -->
    <xsd:element name="storage" type="configType"/>


</xsd:schema>
